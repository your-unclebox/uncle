# =============================================================================
# Uncle — contoh environment variables
# Salin ke .env lalu isi. JANGAN commit .env atau nilai asli apa pun.
# Kredensial Tripay TIDAK ada di sini: disimpan per tenant (terenkripsi) di
# tabel payment_configs lewat Payment Settings (DRD Integrations §1).
# =============================================================================

# --- Aplikasi -----------------------------------------------------------------
NODE_ENV=development
# Domain dasar landing page {slug}.<APP_BASE_DOMAIN> (dev: uncle.localhost:3000)
APP_BASE_DOMAIN=uncle.localhost:3000

# --- Database (Postgres) ------------------------------------------------------
# Fase 1 (wajib). Dev lokal: Postgres dari docker-compose.yml (port 54322).
# Production/staging: Supabase Supavisor pooler mode transaction (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/uncle_dev
# Koneksi langsung/session untuk migrasi (dev: sama dengan DATABASE_URL).
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:54322/uncle_dev
# Password Postgres dev untuk docker-compose (hanya lokal).
DEV_DB_PASSWORD=postgres

# --- Supabase Storage (fase media) --------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=event-media

# --- Kunci kriptografi (fase payment & ticketing) -----------------------------
# KEK untuk envelope encryption kredensial QRIS: 32 byte, base64.
PAYMENT_KEK_V1=
PAYMENT_KEK_ACTIVE_ID=v1
# SANDBOX (dev/staging) atau PRODUCTION
PAYMENT_MODE=SANDBOX
# Opsional: override URL API Tripay (mock lokal/E2E). Kosongkan di staging/production.
TRIPAY_API_BASE_URL=
# Opsional: origin dashboard untuk URL webhook (default https://app.<APP_BASE_DOMAIN>)
APP_URL=
# Kunci HMAC payload QR Tiket (U1.…): minimal 32 byte, base64.
QR_SIGNING_KEY=
# Bearer token untuk /api/internal/cron/*.
CRON_SECRET=

# --- Auth (fase auth) ---------------------------------------------------------
BETTER_AUTH_SECRET=

# --- Email / Resend (fase notifikasi) -----------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=tiket@mail.uncle.id
EMAIL_WEBHOOK_SECRET=

# --- Upstash Redis — rate limit (fase API publik) -----------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (fase checkout) -------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Vercel Domains API — daftar host {slug}.uncle.id saat publish ------------
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Google Maps embed (fase landing) -----------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# --- Sentry (monitoring) ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
